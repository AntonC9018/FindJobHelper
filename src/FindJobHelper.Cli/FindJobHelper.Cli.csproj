<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackageId>Anton.FindJobHelper.Cli</PackageId>
        <Description>Command-line CV generator for FindJobHelper workspaces.</Description>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>find-job-helper</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FindJobHelper.Core\FindJobHelper.Core.csproj" />
        <ProjectReference Include="..\FindJobHelper.Configuration\FindJobHelper.Configuration.csproj" />
        <ProjectReference Include="..\FindJobHelper.Configuration.Json\FindJobHelper.Configuration.Json.csproj" />
        <ProjectReference Include="..\FindJobHelper.Generation\FindJobHelper.Generation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommandDotNet" Version="8.1.1" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>
</Project>
