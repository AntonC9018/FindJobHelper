<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Anton.FindJobHelper.Core</PackageId>
        <Description>Reusable CV selection and generation engine for FindJobHelper.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\FindJobHelper.Configuration\FindJobHelper.Configuration.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CliWrap" Version="3.9.0" />
        <PackageReference Include="CodegenCS.Core" Version="3.5.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <!-- Override Microsoft.Data.Sqlite's vulnerable transitive native bundle. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="data\cv_template_config.tex" />
    </ItemGroup>
</Project>
