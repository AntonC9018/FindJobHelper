<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Anton.FindJobHelper.Templates</PackageId>
    <Description>Fictional starter Workspace for FindJobHelper.</Description>
    <PackageType>Template</PackageType>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TemplateProviderProjectDirectory>src\FindJobWorkspace.Provider</TemplateProviderProjectDirectory>
    <TemplateProviderProjectName>FindJobWorkspace.Provider.csproj</TemplateProviderProjectName>
    <TemplateProviderProject>$(TemplateProviderProjectDirectory)\$(TemplateProviderProjectName)</TemplateProviderProject>
    <TemplateToolManifestDirectory>.config</TemplateToolManifestDirectory>
    <TemplateToolManifestName>dotnet-tools.json</TemplateToolManifestName>
    <TemplateToolManifest>$(TemplateToolManifestDirectory)\$(TemplateToolManifestName)</TemplateToolManifest>
    <!-- run.ps1 is template content, not a NuGet install script. -->
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonPoke" Version="1.3.0" PrivateAssets="All" />
    <Content Include="content\**\*"
             Exclude="content\$(TemplateProviderProject);content\$(TemplateToolManifest)"
             Pack="true"
             PackagePath="content" />
    <Content Include="..\..\src\FindJobHelper.Cli\data\cv-selection.example.json"
             Pack="true"
             PackagePath="content\sent\example\config.json"
             Link="content\sent\example\config.json" />
    <Content Include="..\..\scripts\setup-latex.sh" Pack="true" PackagePath="content\scripts\setup-latex.sh" Link="content\scripts\setup-latex.sh" />
    <Compile Remove="content\**\*.cs" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Stamp the exact Engine package version into staged copies so packing never modifies tracked template source. -->
  <Target Name="StageVersionedTemplateContent" BeforeTargets="_GetPackageFiles" DependsOnTargets="MinVer">
    <PropertyGroup>
      <_VersionedTemplateDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\versioned-template\</_VersionedTemplateDirectory>
      <_StagedProviderProject>$(_VersionedTemplateDirectory)$(TemplateProviderProject)</_StagedProviderProject>
      <_StagedToolManifest>$(_VersionedTemplateDirectory)$(TemplateToolManifest)</_StagedToolManifest>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_StagedProviderProject)'));$([System.IO.Path]::GetDirectoryName('$(_StagedToolManifest)'))" />
    <Copy SourceFiles="content\$(TemplateProviderProject)"
          DestinationFiles="$(_StagedProviderProject)" />
    <Copy SourceFiles="content\$(TemplateToolManifest)"
          DestinationFiles="$(_StagedToolManifest)" />
    <XmlPoke XmlInputPath="$(_StagedProviderProject)"
             Query="/Project/ItemGroup/PackageReference[@Include='Anton.FindJobHelper.Core']/@Version"
             Value="[$(PackageVersion)]" />
    <JsonPoke ContentPath="$(_StagedToolManifest)"
              Query="$.tools['anton.findjobhelper.cli'].version"
              Value="$(PackageVersion)" />
    <ItemGroup>
      <Content Include="$(_StagedProviderProject)" Pack="true" PackagePath="content\$(TemplateProviderProjectDirectory)">
        <Link>$(TemplateProviderProjectName)</Link>
      </Content>
      <Content Include="$(_StagedToolManifest)" Pack="true" PackagePath="content\$(TemplateToolManifestDirectory)">
        <Link>$(TemplateToolManifestName)</Link>
      </Content>
    </ItemGroup>
  </Target>
</Project>
